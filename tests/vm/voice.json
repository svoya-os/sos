{
  "name": "voice",
  "description": "Talking to Jackson the way a user does, with a phrase for a microphone: `sos install voice`, then the bot fetches its phrases (spoken by Vosk TTS on the CI host, tests/vm/voice/prepare.sh) and a small script from the host (\"serve\"), makes a virtual microphone (pw-loopback; the voice service listens to it through SVOYA_VOICE_SOURCE) and opens Jackson's microphone over the shell's IPC (`jackson talk`). The script says each phrase when the voice service says it listens: «Который час?» is answered by the fast path, then Jackson listens again by himself (conversation) and «Спасибо, всё.» ends it. The VM has a sound card whose output is recorded: speaker.ogg is what Jackson said. (ISO #17: one long typed line lagged and garbled in the VM — the script is fetched with a short one.)",
  "vm": {"memory_mib": 8192, "smp": 4, "resolution": [1440, 900], "smbios_product": "sos-vm-test", "audio": true},
  "serve": {"files": "tests/vm/voice", "prepare": "tests/vm/voice/prepare.sh"},
  "steps": [
    {"id": "boot", "action": "wait_serial", "pattern": "SOS 26\\.10", "timeout_s": 60, "optional": true},
    {"id": "boot", "action": "wait_screen", "min_delay_s": 4, "timeout_s": 60},
    {"id": "boot", "action": "key", "keys": ["ret"]},
    {"id": "desktop", "action": "wait_serial", "pattern": "SOS-MARK \\S+ desktop-ready", "fail_pattern": "SOS-MARK \\S+ desktop-timeout", "timeout_s": 600},
    {"id": "desktop", "action": "sleep", "seconds": 8},
    {"id": "desktop", "action": "screenshot", "name": "01-desktop", "assert": "not_blank"},
    {"id": "network", "action": "wait_serial", "pattern": "SOS-MARK \\S+ network-online", "fail_pattern": "SOS-MARK \\S+ network-offline", "timeout_s": 240},
    {"id": "terminal", "action": "key", "keys": ["meta_l", "ret"], "hold_ms": 120},
    {"id": "terminal", "action": "sleep", "seconds": 5},
    {"id": "terminal", "action": "key", "keys": ["meta_l", "f"], "hold_ms": 120},
    {"id": "terminal", "action": "sleep", "seconds": 2},
    {"id": "install", "action": "type", "text": "sos install voice --yes && logger -t sos-vm-test SOS-STEP voice-ready || logger -t sos-vm-test SOS-STEP voice-failed\n"},
    {"id": "install", "action": "sleep", "seconds": 45},
    {"id": "install", "action": "screenshot", "name": "02-installing", "continue_on_failure": true},
    {"id": "install", "action": "wait_serial", "pattern": "SOS-STEP voice-ready", "fail_pattern": "SOS-STEP voice-failed", "timeout_s": 1800},
    {"id": "install", "action": "sleep", "seconds": 2},
    {"id": "install", "action": "screenshot", "name": "03-voice-installed", "continue_on_failure": true},
    {"id": "mic", "action": "type", "text": "clear; curl -sf {serve}/bot.sh -o /tmp/bot.sh && bash /tmp/bot.sh {serve} setup\n"},
    {"id": "mic", "action": "wait_serial", "pattern": "SOS-STEP mic-ready", "fail_pattern": "SOS-STEP phrases-missing", "timeout_s": 180},
    {"id": "mic", "action": "wait_serial", "pattern": "voice ready in|voice models did not load", "timeout_s": 300, "continue_on_failure": true},
    {"id": "mic", "action": "sleep", "seconds": 2},
    {"id": "mic", "action": "screenshot", "name": "04-microphone", "continue_on_failure": true},
    {"id": "mic", "action": "type", "text": "clear; bash /tmp/bot.sh {serve} talk\n"},
    {"id": "talk", "action": "wait_serial", "pattern": "listening \\(tap\\)", "timeout_s": 60, "continue_on_failure": true},
    {"id": "talk", "action": "sleep", "seconds": 1},
    {"id": "talk", "action": "screenshot", "name": "05-listening", "continue_on_failure": true},
    {"id": "talk", "action": "wait_serial", "pattern": "jackson\\.engine: turn done", "fail_pattern": "jackson\\.engine: turn failed", "timeout_s": 120, "continue_on_failure": true},
    {"id": "talk", "action": "sleep", "seconds": 1},
    {"id": "talk", "action": "screenshot", "name": "06-answer", "continue_on_failure": true},
    {"id": "talk", "action": "wait_serial", "pattern": "listening \\(follow\\)", "timeout_s": 60, "continue_on_failure": true},
    {"id": "talk", "action": "sleep", "seconds": 1},
    {"id": "talk", "action": "screenshot", "name": "07-listening-again", "continue_on_failure": true},
    {"id": "talk", "action": "wait_serial", "pattern": "heard [0-9.]+ s of speech", "count": 2, "timeout_s": 60, "continue_on_failure": true},
    {"id": "talk", "action": "sleep", "seconds": 4},
    {"id": "talk", "action": "screenshot", "name": "08-bye", "continue_on_failure": true},
    {"id": "talk", "action": "key", "keys": ["esc"], "continue_on_failure": true},
    {"id": "status", "action": "type", "text": "clear; journalctl --user -u svoya-voice --no-pager | tail -n 14\n", "continue_on_failure": true},
    {"id": "status", "action": "sleep", "seconds": 4},
    {"id": "status", "action": "screenshot", "name": "09-voice-journal", "continue_on_failure": true}
  ]
}
