{
  "name": "games",
  "description": "Games the way a user sets them up: `sos install steam` (the gaming module: Steam with 32-bit drivers, GameMode, MangoHud, gamescope), then Steam from the launcher until its own window: Debian's first-run dialog («Steam installer») gets its «Install» clicked, Steam downloads its client. Steam asks to accept Valve's license during the install; in this throwaway VM the answer «I AGREE» is given beforehand through debconf (agreed by the project owner), a person answers the same question in the terminal.",
  "vm": {
    "memory_mib": 8192,
    "smp": 4,
    "resolution": [1440, 900],
    "smbios_product": "sos-vm-test"
  },
  "steps": [
    {"id": "boot", "action": "wait_serial", "pattern": "SOS 26\\.10", "timeout_s": 60, "optional": true},
    {"id": "boot", "action": "wait_screen", "min_delay_s": 4, "timeout_s": 60},
    {"id": "boot", "action": "key", "keys": ["ret"]},
    {"id": "desktop", "action": "wait_serial", "pattern": "SOS-MARK \\S+ desktop-ready", "fail_pattern": "SOS-MARK \\S+ desktop-timeout", "timeout_s": 600},
    {"id": "desktop", "action": "sleep", "seconds": 10},
    {"id": "desktop", "action": "screenshot", "name": "01-desktop", "assert": "not_blank"},
    {"id": "network", "action": "wait_serial", "pattern": "SOS-MARK \\S+ network-online", "fail_pattern": "SOS-MARK \\S+ network-offline", "timeout_s": 240},

    {"id": "install", "action": "key", "keys": ["meta_l", "ret"], "hold_ms": 120},
    {"id": "install", "action": "sleep", "seconds": 5},
    {"id": "install", "action": "key", "keys": ["meta_l", "f"], "hold_ms": 120},
    {"id": "install", "action": "sleep", "seconds": 2},
    {"id": "install", "action": "type", "text": "for o in steam-installer steam; do echo \"$o steam/question select I AGREE\" | sudo debconf-set-selections; done; sos install steam --yes && logger -t sos-vm-test SOS-STEP games-ready || logger -t sos-vm-test SOS-STEP games-failed\n"},
    {"id": "install", "action": "sleep", "seconds": 90},
    {"id": "install", "action": "screenshot", "name": "02-installing", "continue_on_failure": true},
    {"id": "install", "action": "wait_serial", "pattern": "SOS-STEP games-ready", "fail_pattern": "SOS-STEP games-failed", "timeout_s": 2400},
    {"id": "install", "action": "sleep", "seconds": 2},
    {"id": "install", "action": "screenshot", "name": "03-installed", "continue_on_failure": true},
    {"id": "tools", "action": "type", "text": "clear; dpkg --print-foreign-architectures; dpkg -l steam-installer gamemode mangohud gamescope | tail -n 4; command -v steam gamemoderun mangohud gamescope; sos modules list | grep -i gaming; grep -H -E '^(Name|Exec)=' /usr/share/applications/*team*.desktop /usr/local/share/applications/*team*.desktop | logger -s -t sos-vm-test-steam\n", "continue_on_failure": true},
    {"id": "tools", "action": "sleep", "seconds": 8},
    {"id": "tools", "action": "screenshot", "name": "04-tools", "continue_on_failure": true},
    {"id": "tools", "action": "key", "keys": ["meta_l", "q"], "hold_ms": 120, "continue_on_failure": true},
    {"id": "tools", "action": "sleep", "seconds": 2},

    {"id": "launcher", "action": "key", "keys": ["meta_l", "spc"], "hold_ms": 120, "continue_on_failure": true},
    {"id": "launcher", "action": "sleep", "seconds": 2},
    {"id": "launcher", "action": "type", "text": "steam", "continue_on_failure": true},
    {"id": "launcher", "action": "sleep", "seconds": 2},
    {"id": "launcher", "action": "screenshot", "name": "05-launcher-steam", "continue_on_failure": true},
    {"id": "launcher", "action": "key", "keys": ["ret"], "continue_on_failure": true},
    {"id": "steam", "action": "sleep", "seconds": 20},
    {"id": "steam", "action": "screenshot", "name": "06-steam-installer", "continue_on_failure": true},
    {"id": "steam", "action": "click", "at": [889, 568], "continue_on_failure": true},
    {"id": "steam", "action": "sleep", "seconds": 60},
    {"id": "steam", "action": "screenshot", "name": "07-steam-downloading", "continue_on_failure": true},
    {"id": "steam", "action": "sleep", "seconds": 180},
    {"id": "steam", "action": "screenshot", "name": "08-steam-updating", "continue_on_failure": true},
    {"id": "steam", "action": "sleep", "seconds": 240},
    {"id": "steam", "action": "screenshot", "name": "09-steam-window", "continue_on_failure": true},
    {"id": "after", "action": "key", "keys": ["meta_l", "spc"], "hold_ms": 120, "continue_on_failure": true},
    {"id": "after", "action": "sleep", "seconds": 2},
    {"id": "after", "action": "type", "text": "steam", "continue_on_failure": true},
    {"id": "after", "action": "sleep", "seconds": 2},
    {"id": "after", "action": "screenshot", "name": "10-launcher-after-first-start", "continue_on_failure": true},
    {"id": "after", "action": "key", "keys": ["esc"], "continue_on_failure": true}
  ]
}
