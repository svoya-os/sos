{
  "name": "install-to-disk",
  "description": "Install SOS from the live session onto an empty 64 GB NVMe disk with the real installer (Calamares and the SOS steps), then boot the installed system: the greeter, the login, the first-run wizard. The only test changes to the installer's settings are made in a copy under /tmp by /usr/lib/svoya/vm-test-installer (live image only): «Erase disk» preselected and the user's name filled in; the rest is typed and clicked like a person does. The installer's own steps log to the journal (sos-installer), which the serial console carries.",
  "vm": {
    "memory_mib": 8192,
    "smp": 4,
    "resolution": [1440, 900],
    "smbios_product": "sos-vm-test",
    "disk_gib": 64,
    "reboot": true
  },
  "steps": [
    {"id": "boot", "action": "wait_serial", "pattern": "SOS 26\\.10", "timeout_s": 60, "optional": true},
    {"id": "boot", "action": "wait_screen", "min_delay_s": 4, "timeout_s": 60},
    {"id": "boot", "action": "key", "keys": ["ret"]},
    {"id": "desktop", "action": "wait_serial", "pattern": "SOS-MARK \\S+ desktop-ready", "fail_pattern": "SOS-MARK \\S+ desktop-timeout", "timeout_s": 600},
    {"id": "desktop", "action": "sleep", "seconds": 10},
    {"id": "desktop", "action": "screenshot", "name": "01-live-desktop", "assert": "not_blank"},

    {"id": "installer", "action": "key", "keys": ["meta_l", "ret"], "hold_ms": 120},
    {"id": "installer", "action": "sleep", "seconds": 8},
    {"id": "installer", "action": "type", "text": "/usr/lib/svoya/vm-test-installer\n"},
    {"id": "installer", "action": "wait_serial", "pattern": "SOS-STEP installer-start", "timeout_s": 60},
    {"id": "installer", "action": "sleep", "seconds": 25},
    {"id": "welcome", "action": "screenshot", "name": "02-welcome", "expect_change_from": "01-live-desktop"},
    {"id": "welcome", "action": "key", "keys": ["alt", "n"], "hold_ms": 120},
    {"id": "locale", "action": "sleep", "seconds": 4},
    {"id": "locale", "action": "screenshot", "name": "03-locale", "continue_on_failure": true},
    {"id": "locale", "action": "key", "keys": ["alt", "n"], "hold_ms": 120, "continue_on_failure": true},
    {"id": "keyboard", "action": "sleep", "seconds": 4},
    {"id": "keyboard", "action": "screenshot", "name": "04-keyboard", "continue_on_failure": true},
    {"id": "keyboard", "action": "key", "keys": ["alt", "n"], "hold_ms": 120, "continue_on_failure": true},
    {"id": "partition", "action": "sleep", "seconds": 8},
    {"id": "partition", "action": "screenshot", "name": "05-partition-erase", "continue_on_failure": true},
    {"id": "partition", "action": "key", "keys": ["alt", "n"], "hold_ms": 120, "continue_on_failure": true},
    {"id": "users", "action": "sleep", "seconds": 4},
    {"id": "users", "action": "screenshot", "name": "06-users", "continue_on_failure": true},
    {"id": "users", "action": "key", "keys": ["tab"], "continue_on_failure": true},
    {"id": "users", "action": "key", "keys": ["tab"], "continue_on_failure": true},
    {"id": "users", "action": "key", "keys": ["tab"], "continue_on_failure": true},
    {"id": "users", "action": "type", "text": "Svoya-Test-2026!", "continue_on_failure": true},
    {"id": "users", "action": "key", "keys": ["tab"], "continue_on_failure": true},
    {"id": "users", "action": "type", "text": "Svoya-Test-2026!", "continue_on_failure": true},
    {"id": "users", "action": "sleep", "seconds": 2},
    {"id": "users", "action": "screenshot", "name": "07-users-filled", "continue_on_failure": true},
    {"id": "users", "action": "key", "keys": ["alt", "n"], "hold_ms": 120, "continue_on_failure": true},
    {"id": "summary", "action": "sleep", "seconds": 5},
    {"id": "summary", "action": "screenshot", "name": "08-summary", "continue_on_failure": true},
    {"id": "summary", "action": "key", "keys": ["alt", "i"], "hold_ms": 120, "continue_on_failure": true},
    {"id": "summary", "action": "sleep", "seconds": 3},
    {"id": "summary", "action": "screenshot", "name": "08b-install-now", "continue_on_failure": true},
    {"id": "summary", "action": "key", "keys": ["alt", "i"], "hold_ms": 120, "continue_on_failure": true},

    {"id": "install", "action": "sleep", "seconds": 90},
    {"id": "install", "action": "screenshot", "name": "09-installing", "continue_on_failure": true},
    {"id": "install", "action": "wait_serial", "pattern": "sos-installer\\S*: installation finalized", "fail_pattern": "sos-installer\\S*: error:", "timeout_s": 2400},
    {"id": "install", "action": "sleep", "seconds": 30},
    {"id": "install", "action": "screenshot", "name": "10-finished"},

    {"id": "reboot", "action": "eject"},
    {"id": "reboot", "action": "sleep", "seconds": 2},
    {"id": "reboot", "action": "reset"},
    {"id": "reboot", "action": "sleep", "seconds": 20},
    {"id": "reboot", "action": "screenshot", "name": "11-installed-boot", "continue_on_failure": true},
    {"id": "greeter", "action": "sleep", "seconds": 70},
    {"id": "greeter", "action": "screenshot", "name": "12-greeter", "assert": "not_blank"},
    {"id": "login", "action": "type", "text": "Svoya-Test-2026!\n"},
    {"id": "login", "action": "sleep", "seconds": 45},
    {"id": "login", "action": "screenshot", "name": "13-first-login", "expect_change_from": "12-greeter"},
    {"id": "login", "action": "sleep", "seconds": 30},
    {"id": "login", "action": "screenshot", "name": "14-first-run-wizard", "continue_on_failure": true}
  ]
}
