/* SOS installer, Graphite theme (design/DESIGN.md). SPDX-License-Identifier: Apache-2.0
   Matte surfaces, 1px hairlines, one amber signal colour. */

QWidget {
    background-color: #141518;
    color: #ebe8e1;
    font-family: "IBM Plex Sans";
    font-size: 13px;
    selection-background-color: #ffb547;
    selection-color: #1b1204;
}

#mainApp, #sidebarApp {
    background-color: #0e0f11;
}

#sidebarMenuApp {
    background-color: #0e0f11;
    color: #9d9a92;
    border-right: 1px solid #25282d;
}

QLabel { background: transparent; }

QPushButton {
    background-color: #191b1f;
    color: #ebe8e1;
    border: 1px solid #363a41;
    border-radius: 9px;
    padding: 7px 16px;
    font-weight: 500;
}
QPushButton:hover { border-color: #ffb547; }
QPushButton:pressed { background-color: #22252a; }
QPushButton:disabled { color: #67655f; border-color: #25282d; }
QPushButton:default, QPushButton#view-button-next, QPushButton#view-button-install {
    background-color: #ffb547;
    color: #1b1204;
    border: 1px solid #ffb547;
}

QLineEdit, QComboBox, QSpinBox, QListView, QTreeView, QTableView, QTextEdit, QPlainTextEdit {
    background-color: #191b1f;
    color: #ebe8e1;
    border: 1px solid #25282d;
    border-radius: 6px;
    padding: 4px 6px;
}
QLineEdit:focus, QComboBox:focus { border: 2px solid #ffb547; }

QComboBox QAbstractItemView {
    background-color: #191b1f;
    border: 1px solid #363a41;
}

QCheckBox, QRadioButton { background: transparent; spacing: 8px; }

QProgressBar {
    background-color: #22252a;
    border: none;
    border-radius: 3px;
    height: 6px;
    text-align: center;
    color: transparent;
}
QProgressBar::chunk {
    background-color: #ffb547;
    border-radius: 3px;
}

QScrollBar:vertical { background: #141518; width: 10px; }
QScrollBar::handle:vertical { background: #363a41; border-radius: 5px; min-height: 24px; }
QScrollBar::add-line, QScrollBar::sub-line { height: 0; }
