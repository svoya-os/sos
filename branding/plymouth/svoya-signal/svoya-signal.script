# svoya-signal.script — Svoya OS boot splash «Сигнал» for the Plymouth script plugin.
#
#   power on : a phosphor spot in the centre stretches into a horizontal line (CRT warm-up)
#   boot     : the Morse «СОС» burst rides the line as the progress indicator — the line is lit
#              behind it, and the burst keeps transmitting ··· ——— ··· in real Morse timing
#   unlock   : the signal dims, a terminal-style line takes the passphrase (every key = one dot)
#   shutdown / reboot / updates / firmware / reset: same line, a caption says what is happening
#
# Plymouth script API used (verified against plymouth 24.004 sources): Window.Get{Width,Height,X,Y},
# Window.SetBackground{Top,Bottom}Color, Image(), Image.Text(text, r, g, b, a, font, align),
# Image.Scale, Sprite, Sprite.Set{X,Y,Z,Opacity,Image}, Plymouth.Set*Function, Plymouth.GetMode,
# Plymouth.GetCapslockState (24.x, guarded), Math.*, String.SubString.
# Strings are byte strings in Plymouth: this script never cuts or measures Cyrillic text.
#
# SPDX-License-Identifier: Apache-2.0 (script) · artwork (PNG sprites) CC BY-SA 4.0

# ─────────────────────────── geometry (generated by branding/plymouth/generate.py) ───────────────────────────
# @generated-begin
FPS = 50;
LINE_FRAC = 0.62;
LINE_MAX = 1180;
LINE_Y_FRAC = 0.46;
FADE_FRAC = 0.2;
LINE_CORE = 7;
BURST_W = 205;
BURST_BASE = 22;
BURST_LEAD = 12;
BURST_TAIL = 64;
FLARE_PAD = 14;
FLARE_BASE = 24;
N_SYMBOLS = 9;
SYMBOL_X[0] = 0; SYMBOL_W[0] = 7; SYMBOL_ON[0] = 0; SYMBOL_LEN[0] = 1;
SYMBOL_X[1] = 14; SYMBOL_W[1] = 7; SYMBOL_ON[1] = 2; SYMBOL_LEN[1] = 1;
SYMBOL_X[2] = 28; SYMBOL_W[2] = 7; SYMBOL_ON[2] = 4; SYMBOL_LEN[2] = 1;
SYMBOL_X[3] = 56; SYMBOL_W[3] = 21; SYMBOL_ON[3] = 8; SYMBOL_LEN[3] = 3;
SYMBOL_X[4] = 84; SYMBOL_W[4] = 21; SYMBOL_ON[4] = 12; SYMBOL_LEN[4] = 3;
SYMBOL_X[5] = 112; SYMBOL_W[5] = 21; SYMBOL_ON[5] = 16; SYMBOL_LEN[5] = 3;
SYMBOL_X[6] = 154; SYMBOL_W[6] = 7; SYMBOL_ON[6] = 22; SYMBOL_LEN[6] = 1;
SYMBOL_X[7] = 168; SYMBOL_W[7] = 7; SYMBOL_ON[7] = 24; SYMBOL_LEN[7] = 1;
SYMBOL_X[8] = 182; SYMBOL_W[8] = 7; SYMBOL_ON[8] = 26; SYMBOL_LEN[8] = 1;
KEY_UNIT = 0.1;
KEY_PERIOD = 34;
BASE_OPACITY = 0.34;
BURST_REST = 0.72;
T_SPOT = 0.18;
T_HOLD = 0.16;
T_STRETCH = 0.42;
T_SETTLE = 0.3;
T_BURST = 0.26;
T_WORD = 0.4;
WORD_GAP = 58;
CAPTION_GAP = 14;
PROMPT_GAP = 54;
FIELD_W = 380;
BULLET_PITCH = 11;
MSG_BOTTOM = 64;
MSG_LINE = 22;
FONT_MONO = "IBM Plex Mono 13px";
FONT_MONO_SMALL = "IBM Plex Mono 12px";
BG_TOP_R = 0.059; BG_TOP_G = 0.063; BG_TOP_B = 0.071;
BG_BOTTOM_R = 0.043; BG_BOTTOM_G = 0.047; BG_BOTTOM_B = 0.055;
TEXT_R = 0.922; TEXT_G = 0.910; TEXT_B = 0.882;
DIM_R = 0.616; DIM_G = 0.604; DIM_B = 0.573;
FAINT_R = 0.404; FAINT_G = 0.396; FAINT_B = 0.373;
# @generated-end

# ─────────────────────────── helpers ───────────────────────────
fun clamp01 (v) { if (v < 0) return 0; if (v > 1) return 1; return v; }
fun ease_out (v) { local.k = 1 - clamp01 (v); return 1 - local.k * local.k * local.k; }   # OutCubic
fun smooth (v) { local.k = clamp01 (v); return local.k * local.k * (3 - 2 * local.k); }
fun approach (cur, target, rate) { return cur + (target - cur) * rate; }
fun phase (t, start, len) { return clamp01 ((t - start) / len); }

fun make_sprite (image, z)
{
  local.s = Sprite ();
  if (image) local.s.SetImage (image);
  local.s.SetZ (z);
  local.s.SetOpacity (0);
  return local.s;
}

# Image.Text needs the label plugin (pango or freetype) in the initrd; fall back to a
# pre-rendered PNG when it is missing so the screen never shows an empty prompt.
fun text_image (text, r, g, b, font)
{
  if (!text) return NULL;
  local.img = Image.Text (text, r, g, b, 1, font, "center");
  if (!local.img) return NULL;
  if (local.img.GetWidth () < 1) return NULL;
  return local.img;
}

fun fit_width (img, max_w)
{
  if (!img) return NULL;
  if (img.GetWidth () <= max_w) return img;
  return img.Scale (max_w, Math.Int (img.GetHeight () * max_w / img.GetWidth ()));
}

# ─────────────────────────── state ───────────────────────────
Window.SetBackgroundTopColor (BG_TOP_R, BG_TOP_G, BG_TOP_B);
Window.SetBackgroundBottomColor (BG_BOTTOM_R, BG_BOTTOM_G, BG_BOTTOM_B);

mode = Plymouth.GetMode ();
lang = "ru";
if (global.svoya_lang == "en") lang = "en";

frame = 0;
progress.target = 0;
progress.shown = 0;
ui.state = "normal";          # normal | password | question
ui.dim = 0;                   # 0 → 1 while a prompt is shown
ui.quit = 0;

img.spot = Image ("spot.png");
img.streak = Image ("streak.png");
img.line = Image ("line.png");
img.lit = Image ("lit.png");
img.litfade = Image ("lit-fade.png");
img.burst = Image ("burst.png");
img.flare_dot = Image ("flare-dot.png");
img.flare_dash = Image ("flare-dash.png");
img.haze = Image ("haze.png");
img.wordmark = Image ("wordmark-" + lang + ".png");
img.chevron = Image ("chevron.png");
img.bullet = Image ("bullet.png");
img.cursor = Image ("cursor.png");
img.rule = Image ("rule.png");
img.caps = Image ("caps-" + lang + ".png");

caption_name = "boot";
if (mode == "shutdown") caption_name = "shutdown";
if (mode == "reboot") caption_name = "reboot";
if (mode == "updates") caption_name = "updates";
if (mode == "system-upgrade") caption_name = "upgrade";
if (mode == "firmware-upgrade") caption_name = "firmware";
if (mode == "system-reset") caption_name = "reset";
img.caption = Image ("caption-" + caption_name + "-" + lang + ".png");
img.unlock = Image ("caption-unlock-" + lang + ".png");
img.question = Image ("caption-question-" + lang + ".png");
img.keepon = Image ("caption-keepon-" + lang + ".png");

# a moving burst for boot and updates; a centred, still one for shutdown/reboot/reset
travels = 1;
if (mode == "shutdown" || mode == "reboot" || mode == "system-reset") travels = 0;
with_percent = 0;
if (mode == "updates" || mode == "system-upgrade" || mode == "firmware-upgrade") with_percent = 1;

s.haze = make_sprite (img.haze, 1);
s.line = make_sprite (NULL, 10);
s.litfade = make_sprite (NULL, 11);
s.lit = make_sprite (NULL, 11);
s.streak = make_sprite (NULL, 12);
s.spot = make_sprite (img.spot, 13);
s.burst = make_sprite (img.burst, 14);
for (local.i = 0; local.i < N_SYMBOLS; local.i++)
  {
    if (SYMBOL_LEN[local.i] == 1) s.flare[local.i] = make_sprite (img.flare_dot, 15);
    else s.flare[local.i] = make_sprite (img.flare_dash, 15);
  }
s.wordmark = make_sprite (img.wordmark, 20);
s.caption = make_sprite (img.caption, 20);
s.percent = make_sprite (NULL, 20);
s.keepon = make_sprite (img.keepon, 20);

s.p_caption = make_sprite (img.unlock, 30);
s.p_text = make_sprite (NULL, 30);
s.p_chevron = make_sprite (img.chevron, 30);
s.p_cursor = make_sprite (img.cursor, 31);
s.p_rule = make_sprite (NULL, 30);
s.p_caps = make_sprite (img.caps, 30);
s.p_entry = make_sprite (NULL, 30);
bullets.count = 0;
bullets.made = 0;

msg.count = 0;

# ─────────────────────────── layout ───────────────────────────
fun layout ()
{
  global.W = Window.GetWidth ();
  global.H = Window.GetHeight ();
  global.X0 = Window.GetX ();
  global.Y0 = Window.GetY ();

  global.line.w = Math.Int (Math.Min (W * LINE_FRAC, LINE_MAX));
  global.line.x = X0 + Math.Int ((W - line.w) / 2);
  global.line.y = Y0 + Math.Int (H * LINE_Y_FRAC);
  global.line.cx = X0 + Math.Int (W / 2);
  global.line.fade = Math.Int (line.w * FADE_FRAC);

  global.travel.x0 = line.x + line.fade - BURST_LEAD;
  global.travel.x1 = line.x + line.w - line.fade - BURST_W + BURST_TAIL;

  s.line.SetImage (img.line.Scale (line.w, img.line.GetHeight ()));
  s.line.SetX (line.x);
  s.line.SetY (line.y - LINE_CORE);
  s.litfade.SetImage (img.litfade.Scale (line.fade, img.litfade.GetHeight ()));
  s.litfade.SetX (line.x);
  s.litfade.SetY (line.y - LINE_CORE);
  s.lit.SetY (line.y - LINE_CORE);
  s.streak.SetY (line.y - Math.Int (img.streak.GetHeight () / 2));
  s.spot.SetX (line.cx - Math.Int (img.spot.GetWidth () / 2));
  s.spot.SetY (line.y - Math.Int (img.spot.GetHeight () / 2));
  s.burst.SetY (line.y - BURST_BASE);
  for (local.i = 0; local.i < N_SYMBOLS; local.i++)
    s.flare[local.i].SetY (line.y - FLARE_BASE);
  local.hw = Math.Int (line.w * 1.3);
  local.hh = Math.Int (local.hw * img.haze.GetHeight () / img.haze.GetWidth ());
  s.haze.SetImage (img.haze.Scale (local.hw, local.hh));
  s.haze.SetX (line.cx - Math.Int (local.hw / 2));
  s.haze.SetY (line.y - Math.Int (local.hh / 2));

  global.word.y = line.y + WORD_GAP;
  s.wordmark.SetX (line.cx - Math.Int (img.wordmark.GetWidth () / 2));
  global.caption.y = word.y + img.wordmark.GetHeight () + CAPTION_GAP;
  s.caption.SetX (line.cx - Math.Int (img.caption.GetWidth () / 2));
  s.keepon.SetX (line.cx - Math.Int (img.keepon.GetWidth () / 2));

  global.field.w = Math.Min (FIELD_W, W - 64);
  global.field.x = X0 + Math.Int ((W - field.w) / 2);
  global.prompt.y = line.y + PROMPT_GAP;
  s.p_caption.SetX (line.cx - Math.Int (img.unlock.GetWidth () / 2));
  s.p_caption.SetY (prompt.y);
  s.p_rule.SetImage (img.rule.Scale (field.w, 1));
  s.p_rule.SetX (field.x);
  s.p_chevron.SetX (field.x);

  global.msg.base_y = Y0 + H - MSG_BOTTOM;
  place_prompt_rows ();
  place_messages ();
}

# the prompt text height is only known once Image.Text has rendered it
fun place_prompt_rows ()
{
  local.text_h = 0;
  if (global.prompt.text_img) local.text_h = global.prompt.text_img.GetHeight () + 10;
  global.prompt.row_y = prompt.y + img.unlock.GetHeight () + 14 + local.text_h;
  s.p_chevron.SetY (prompt.row_y);
  s.p_cursor.SetY (prompt.row_y + Math.Int ((img.chevron.GetHeight () - img.cursor.GetHeight ()) / 2));
  s.p_entry.SetY (prompt.row_y + Math.Int ((img.chevron.GetHeight () - 18) / 2));
  s.p_rule.SetY (prompt.row_y + img.chevron.GetHeight () + 10);
  s.p_caps.SetX (field.x + field.w - img.caps.GetWidth ());
  s.p_caps.SetY (prompt.row_y + Math.Int ((img.chevron.GetHeight () - img.caps.GetHeight ()) / 2));
  global.bullets.y = prompt.row_y + Math.Int ((img.chevron.GetHeight () - img.bullet.GetHeight ()) / 2);
  global.bullets.x = field.x + img.chevron.GetWidth () + 12;
  global.bullets.max = Math.Int ((field.w - img.chevron.GetWidth () - 12 - img.caps.GetWidth () - 16) / BULLET_PITCH);
  for (local.i = 0; local.i < bullets.made; local.i++)
    {
      bullets.sprite[local.i].SetX (bullets.x + local.i * BULLET_PITCH);
      bullets.sprite[local.i].SetY (bullets.y);
    }
}

# ─────────────────────────── messages (bottom, newest last, at most 3) ───────────────────────────
fun place_messages ()
{
  for (local.i = 0; local.i < msg.count; local.i++)
    {
      local.im = msg.image[local.i];
      if (local.im)
        {
          msg.sprite[local.i].SetX (X0 + Math.Int ((W - local.im.GetWidth ()) / 2));
          msg.sprite[local.i].SetY (msg.base_y - (msg.count - local.i) * MSG_LINE);
        }
    }
}

fun display_message_callback (text)
{
  if (msg.count >= 3)
    {
      msg.sprite[0].SetOpacity (0);
      for (local.i = 1; local.i < msg.count; local.i++)
        {
          msg.text[local.i - 1] = msg.text[local.i];
          msg.image[local.i - 1] = msg.image[local.i];
          msg.sprite[local.i - 1] = msg.sprite[local.i];
        }
      msg.count--;
    }
  local.im = fit_width (text_image (text, DIM_R, DIM_G, DIM_B, FONT_MONO_SMALL), W - 64);
  msg.text[msg.count] = text;
  msg.image[msg.count] = local.im;
  msg.sprite[msg.count] = make_sprite (local.im, 40);
  msg.sprite[msg.count].SetOpacity (1);
  msg.count++;
  place_messages ();
}

fun hide_message_callback (text)
{
  for (local.i = 0; local.i < msg.count; local.i++)
    {
      if (msg.text[local.i] == text)
        {
          msg.sprite[local.i].SetOpacity (0);
          for (local.j = local.i + 1; local.j < msg.count; local.j++)
            {
              msg.text[local.j - 1] = msg.text[local.j];
              msg.image[local.j - 1] = msg.image[local.j];
              msg.sprite[local.j - 1] = msg.sprite[local.j];
            }
          msg.count--;
          place_messages ();
          return;
        }
    }
}

# ─────────────────────────── prompts ───────────────────────────
fun set_prompt_text (text)
{
  if (text == global.prompt.last_text) return;
  global.prompt.last_text = text;
  global.prompt.text_img = fit_width (text_image (text, DIM_R, DIM_G, DIM_B, FONT_MONO), W - 64);
  if (global.prompt.text_img)
    {
      s.p_text.SetImage (global.prompt.text_img);
      s.p_text.SetX (line.cx - Math.Int (global.prompt.text_img.GetWidth () / 2));
      s.p_text.SetY (prompt.y + img.unlock.GetHeight () + 10);
    }
  place_prompt_rows ();
}

fun set_bullets (n)
{
  bullets.count = n;
  local.shown = Math.Min (n, bullets.max);
  while (bullets.made < local.shown)
    {
      bullets.sprite[bullets.made] = make_sprite (img.bullet, 31);
      bullets.sprite[bullets.made].SetX (bullets.x + bullets.made * BULLET_PITCH);
      bullets.sprite[bullets.made].SetY (bullets.y);
      bullets.made++;
    }
  global.bullets.shown = local.shown;
  global.prompt.cursor_x = bullets.x + local.shown * BULLET_PITCH;
}

fun display_password_callback (prompt_text, bullet_count)
{
  global.ui.state = "password";
  s.p_caption.SetImage (img.unlock);
  set_prompt_text (prompt_text);
  set_bullets (bullet_count);
}

fun display_question_callback (prompt_text, entry)
{
  global.ui.state = "question";
  s.p_caption.SetImage (img.question);
  set_prompt_text (prompt_text);
  set_bullets (0);
  global.prompt.entry_img = NULL;
  if (entry) global.prompt.entry_img = text_image (entry, TEXT_R, TEXT_G, TEXT_B, FONT_MONO);
  global.prompt.cursor_x = bullets.x;
  if (global.prompt.entry_img)
    {
      s.p_entry.SetImage (global.prompt.entry_img);
      s.p_entry.SetX (bullets.x);
      global.prompt.cursor_x = bullets.x + global.prompt.entry_img.GetWidth () + 4;
    }
}

fun display_normal_callback ()
{
  global.ui.state = "normal";
}

# ─────────────────────────── progress sources ───────────────────────────
fun boot_progress_callback (duration, fraction)
{
  if (!with_percent && fraction > progress.target) global.progress.target = fraction;
}

fun system_update_callback (percent)
{
  global.progress.target = clamp01 (percent / 100);
  if (percent != global.progress.percent)
    {
      global.progress.percent = percent;
      local.label = "" + Math.Int (percent) + " %";
      local.im = text_image (local.label, DIM_R, DIM_G, DIM_B, FONT_MONO);
      if (local.im)
        {
          s.percent.SetImage (local.im);
          s.percent.SetX (line.cx - Math.Int (local.im.GetWidth () / 2));
          s.percent.SetY (caption.y + img.caption.GetHeight () + 12);
        }
    }
}

fun update_status_callback (status)
{
  # Ubuntu's systemd-fsckd asks the splash to show its (already translated) cancel hint
  if (status.SubString (0, 17) == "fsckd-cancel-msg:")
    display_message_callback (status.SubString (17, 4096));
}

fun quit_callback ()
{
  global.ui.quit = 1;
  global.progress.target = 1;
}

# ─────────────────────────── the frame ───────────────────────────
fun key_level (unit_time, i)
{
  # Morse keying envelope for symbol i: soft attack, phosphor-like decay
  local.u = unit_time - SYMBOL_ON[i];
  if (local.u < 0) return 0;
  local.on = SYMBOL_LEN[i];
  if (local.u < local.on) return smooth (local.u / 0.45);
  local.d = (local.u - local.on) / 2.2;
  if (local.d >= 1) return 0;
  return (1 - local.d) * (1 - local.d);
}

fun refresh_callback ()
{
  global.frame++;
  local.t = frame / FPS;

  # CRT warm-up timeline
  local.t_stretch = T_SPOT + T_HOLD;
  local.t_line = local.t_stretch + T_STRETCH;
  local.spot_in = ease_out (phase (local.t, 0, T_SPOT));
  local.stretch = ease_out (phase (local.t, local.t_stretch, T_STRETCH));
  local.settle = smooth (phase (local.t, local.t_line - 0.1, T_SETTLE));
  local.burst_in = ease_out (phase (local.t, local.t_line, T_BURST));
  local.word_in = ease_out (phase (local.t, local.t_line + 0.12, T_WORD));

  # prompts dim the signal and hide the wordmark
  local.want_dim = 0;
  if (ui.state != "normal") local.want_dim = 1;
  global.ui.dim = approach (ui.dim, local.want_dim, 0.18);
  local.signal = 1 - 0.62 * ui.dim;

  # spot → streak → line
  s.spot.SetOpacity (local.spot_in * (1 - smooth (phase (local.t, local.t_stretch, T_STRETCH * 0.55))));
  if (local.t >= local.t_stretch && local.settle < 1)
    {
      local.sw = Math.Int (img.streak.GetWidth () * 0.5 + (line.w - img.streak.GetWidth () * 0.5) * local.stretch);
      s.streak.SetImage (img.streak.Scale (local.sw, img.streak.GetHeight ()));
      s.streak.SetX (line.cx - Math.Int (local.sw / 2));
      s.streak.SetOpacity ((1 - local.settle) * 0.95);
    }
  else
    s.streak.SetOpacity (0);
  s.line.SetOpacity (BASE_OPACITY * local.settle * local.signal);
  s.haze.SetOpacity ((0.35 + 0.65 * local.settle) * local.spot_in * (1 - 0.5 * ui.dim));

  # progress: only forward, eased, and only once the burst is on the line
  if (local.burst_in > 0.5 && progress.shown < progress.target)
    global.progress.shown = approach (progress.shown, progress.target, 0.06);
  if (!travels) global.progress.shown = 0.5;

  local.bx = Math.Int (travel.x0 + (travel.x1 - travel.x0) * progress.shown);
  s.burst.SetX (local.bx);
  s.burst.SetOpacity (local.burst_in * BURST_REST * local.signal);

  # lit segment between the fade-in and the burst
  local.lit_w = local.bx + BURST_LEAD - (line.x + line.fade);
  if (travels && local.lit_w > 0)
    {
      if (local.lit_w != global.lit.last_w)
        {
          s.lit.SetImage (img.lit.Scale (local.lit_w, img.lit.GetHeight ()));
          s.lit.SetX (line.x + line.fade);
          global.lit.last_w = local.lit_w;
        }
      s.lit.SetOpacity (local.burst_in * 0.9 * local.signal);
      s.litfade.SetOpacity (local.burst_in * 0.9 * local.signal);
    }
  else
    {
      s.lit.SetOpacity (0);
      local.lf = 0;
      if (travels) local.lf = local.burst_in * 0.9 * local.signal;
      s.litfade.SetOpacity (local.lf);
    }

  # the burst transmits ··· ——— ··· (KEY_UNIT seconds per Morse unit, 7-unit word gap)
  local.kt = (local.t - local.t_line) / KEY_UNIT;
  local.unit_time = local.kt % KEY_PERIOD;
  if (local.kt < 0) local.unit_time = -100;
  for (local.i = 0; local.i < N_SYMBOLS; local.i++)
    {
      s.flare[local.i].SetX (local.bx + SYMBOL_X[local.i] - FLARE_PAD);
      s.flare[local.i].SetOpacity (key_level (local.unit_time, local.i) * local.burst_in * local.signal);
    }

  # wordmark and caption
  local.word_op = local.word_in * (1 - ui.dim);
  s.wordmark.SetY (word.y + Math.Int (4 * (1 - local.word_in)));
  s.wordmark.SetOpacity (local.word_op * 0.92);
  s.caption.SetY (caption.y + Math.Int (4 * (1 - local.word_in)));
  s.caption.SetOpacity (local.word_op);
  s.percent.SetOpacity (local.word_op * with_percent);
  s.keepon.SetY (caption.y + img.caption.GetHeight () + 40);
  s.keepon.SetOpacity (local.word_op * with_percent);

  # prompt
  local.p = ui.dim;
  if (ui.state == "normal") local.p = ui.dim * ui.dim;
  s.p_caption.SetOpacity (local.p);
  local.has_text = 0;
  if (global.prompt.text_img) local.has_text = 1;
  s.p_text.SetOpacity (local.p * local.has_text);
  s.p_chevron.SetOpacity (local.p);
  s.p_rule.SetOpacity (local.p);
  local.blink = 0.35 + 0.65 * (0.5 + 0.5 * Math.Cos (2 * Math.Pi * local.t / 1.1));
  s.p_cursor.SetX (global.prompt.cursor_x);
  s.p_cursor.SetOpacity (local.p * local.blink);
  local.q = 0;
  if (ui.state == "question" && global.prompt.entry_img) local.q = 1;
  s.p_entry.SetOpacity (local.p * local.q);
  local.caps = 0;
  if (ui.state == "password" && Plymouth.GetCapslockState)
    local.caps = Plymouth.GetCapslockState ();
  s.p_caps.SetOpacity (local.p * local.caps);
  for (local.i = 0; local.i < bullets.made; local.i++)
    {
      local.b = 0;
      if (ui.state == "password" && local.i < bullets.shown) local.b = 1;
      bullets.sprite[local.i].SetOpacity (local.p * local.b);
    }
}

# ─────────────────────────── wiring ───────────────────────────
layout ();

fun display_hotplug_callback ()
{
  layout ();
}

Plymouth.SetRefreshFunction (refresh_callback);
Plymouth.SetBootProgressFunction (boot_progress_callback);
Plymouth.SetUpdateStatusFunction (update_status_callback);
Plymouth.SetDisplayNormalFunction (display_normal_callback);
Plymouth.SetDisplayPasswordFunction (display_password_callback);
Plymouth.SetDisplayQuestionFunction (display_question_callback);
Plymouth.SetDisplayMessageFunction (display_message_callback);
Plymouth.SetHideMessageFunction (hide_message_callback);
Plymouth.SetQuitFunction (quit_callback);
if (Plymouth.SetSystemUpdateFunction) Plymouth.SetSystemUpdateFunction (system_update_callback);
if (Plymouth.SetDisplayHotplugFunction) Plymouth.SetDisplayHotplugFunction (display_hotplug_callback);
