#!/usr/bin/python3
# SPDX-License-Identifier: Apache-2.0
"""Jackson background service (installed as /usr/lib/svoya/jacksond; systemd user unit jacksond.service)."""
import os
import sys

_src = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if os.path.isfile(os.path.join(_src, "jackson", "__init__.py")):
    sys.path.insert(0, _src)
else:
    sys.path.insert(0, "/usr/lib/svoya")

from jackson.daemon import main  # noqa: E402

sys.exit(main())
