#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Jackson's ears and voice (installed as /usr/lib/svoya/svoya-voice; user unit svoya-voice.service).

Runs with the voice module's venv (/opt/svoya/venvs/voice/bin/python): numpy, onnxruntime, onnx-asr
and the speech engine live there, the jackson package in /usr/lib/svoya.
"""
import os
import sys

_src = os.path.dirname(os.path.dirname(os.path.realpath(__file__)))
if os.path.isfile(os.path.join(_src, "jackson", "__init__.py")):
    sys.path.insert(0, _src)
else:
    sys.path.insert(0, "/usr/lib/svoya")

from jackson.voice.service import main  # noqa: E402

sys.exit(main())
