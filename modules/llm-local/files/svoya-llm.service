# SOS module llm-local: llama.cpp in router mode over the shared store (localhost only).
# Not enabled by default — start it when you want it: systemctl --user start svoya-llm
[Unit]
Description=Local LLM server (llama.cpp router over /srv/ai) — SOS
Documentation=https://github.com/ggml-org/llama.cpp/tree/master/tools/server
# The AI switch (`sos ai off`): never start while it is off, for this user or for everyone
ConditionPathExists=!%h/.config/svoya/ai.off
ConditionPathExists=!/etc/svoya/ai.off

[Service]
# The context window. llama.cpp's own default is the model's training context: 262k tokens for
# Qwen3.5, some 8 GB of cache, and a 12 GB machine ran out of memory before the first answer.
# 16k tokens fit Jackson's conversations and most documents in a few hundred MB. Your own value:
# LLAMA_ARG_CTX_SIZE=32768 in ~/.config/svoya/llm.env
Environment=LLAMA_ARG_CTX_SIZE=16384
EnvironmentFile=-%h/.config/svoya/llm.env
ExecStartPre=-/usr/bin/sos models views --quiet
ExecStart=/usr/bin/llama-server --host 127.0.0.1 --port 8080 --models-dir /srv/ai/views/llama.cpp --models-max 2 --jinja
Restart=on-failure

[Install]
WantedBy=default.target
