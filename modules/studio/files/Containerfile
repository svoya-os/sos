# SOS Studio — ComfyUI (GPL-3.0) in a container. Built locally by `sos-studio build`.
# GPU: NVIDIA via CDI (--device nvidia.com/gpu=all), AMD via /dev/kfd + /dev/dri.
FROM docker.io/library/python:3.12-slim
ARG TORCH_BACKEND=cpu
RUN apt-get update && apt-get install -y --no-install-recommends git ffmpeg libgl1 libglib2.0-0 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
# PyTorch first, on its own layer: a newer ComfyUI (below) does not download it again
RUN uv pip install --system --torch-backend="${TORCH_BACKEND}" torch torchvision torchaudio
RUN useradd --create-home --uid 1000 studio
# `sos-studio build` passes the upstream commit: a new ComfyUI is fetched, the layers above stay cached
ARG COMFY_REF=master
ARG COMFY_COMMIT=unknown
RUN echo "ComfyUI ${COMFY_REF} ${COMFY_COMMIT}" \
    && git clone --depth 1 --branch "${COMFY_REF}" https://github.com/comfyanonymous/ComfyUI /opt/ComfyUI \
    && uv pip install --system -r /opt/ComfyUI/requirements.txt \
    && chown -R studio /opt/ComfyUI
COPY entrypoint.sh /usr/local/bin/sos-studio-entrypoint
USER studio
WORKDIR /opt/ComfyUI
EXPOSE 8188
ENTRYPOINT ["/usr/local/bin/sos-studio-entrypoint"]
