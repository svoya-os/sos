# SPDX-License-Identifier: Apache-2.0
# SOS gaming module: Steam may create user namespaces.
#
# Steam's runtime needs them: the requirements check at every start (srt-bwrap) and pressure-vessel,
# the container games run in. Ubuntu allows user namespaces only to programs whose AppArmor profile
# says so, and Steam stopped with «Steam now requires user namespaces to be enabled» (the games bot).
# These profiles confine nothing (flags=unconfined); they name the programs in Steam's folders and
# grant them `userns`. Debian's steam-installer keeps Steam in ~/.steam/debian-installation, Valve's
# own package in ~/.local/share/Steam; games in another library bring their runtime along.
abi <abi/4.0>,
include <tunables/global>

profile sos-steam @{HOME}/{.steam/debian-installation,.local/share/Steam}/** flags=(unconfined) {
  userns,

  include if exists <local/sos-steam>
}

profile sos-steam-runtime /**/steamapps/common/SteamLinuxRuntime_*/** flags=(unconfined) {
  userns,

  include if exists <local/sos-steam-runtime>
}
