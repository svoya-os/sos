# shellcheck shell=bash
# SPDX-License-Identifier: Apache-2.0
# Pinned inputs for packages/build-all.sh. Every value can be overridden from the environment.
# Bump a pin in one commit together with the reason (upstream release notes, CVE, ...).

# Version of our own svoya-* packages (native packages, no Debian revision).
: "${SVOYA_PKG_VERSION:=0.1.0}"
: "${SVOYA_MAINTAINER:=SOS developers <sos@users.noreply.github.com>}"
: "${SVOYA_HOMEPAGE:=https://github.com/svoya-os/sos}"

# Quickshell — not in the Ubuntu 26.04 archive; built from source.
# Canonical repository: https://git.outfoxxed.me/quickshell/quickshell (GitHub mirror below).
# Quickshell uses private Qt APIs, so it must be rebuilt whenever the archive's Qt (6.10.x) changes.
: "${QUICKSHELL_VERSION:=0.3.1}"
: "${QUICKSHELL_REPO:=https://github.com/quickshell-mirror/quickshell}"
: "${QUICKSHELL_COMMIT:=1a4716cde794a59928d9d9fc15f2afc7a95de360}"   # tag v0.3.1 (2026-08-20)

# uv — not in the archive; repackaged from the official release binary (sha256-verified).
: "${UV_VERSION:=0.12.18}"
# sha256 of uv-x86_64-unknown-linux-gnu.tar.gz 0.12.18, matching the release's published .sha256
# (checked 2026-09-25). Update together with UV_VERSION; empty = trust the published .sha256.
: "${UV_SHA256_X86_64=89eadd7c76fc063887959510d5ba0ab1264dfd5f1143b925ddb73021a40acf16}"

# grub-btrfs — not in the archive; boot entries for snapper snapshots ("yesterday's system").
: "${GRUB_BTRFS_VERSION:=4.14}"
: "${GRUB_BTRFS_REPO:=https://github.com/Antynea/grub-btrfs}"
: "${GRUB_BTRFS_COMMIT:=2fcfbe967637166b88dadd49c834807243a941bf}"   # tag v4.14

# UpsiL — the SOS language for AI scripts (github.com/svoya-os/upsil), packaged from a pinned commit.
# The package is optional: until that commit can be fetched, the ISO is built without it.
# UPSIL_SRC_DIR=<checkout> builds from a local tree instead: UPSIL_SRC_DIR=../upsil packages/build-all.sh --only upsil
: "${UPSIL_VERSION:=0.3.0}"
: "${UPSIL_REPO:=https://github.com/svoya-os/upsil}"
: "${UPSIL_COMMIT:=4dcef5d69b11bf8018d71de779ba9991dfd8283c}"   # main, 0.3.0

# Fonts (svoya-fonts) — fetched by git at build time.
: "${PLEX_REPO:=https://github.com/IBM/plex}"
: "${PLEX_COMMIT:=1da12f02587b630c07e92692d21492d722f53614}"          # tag @ibm/plex-sans@1.1.0 (monorepo, sans+mono)
: "${DEPARTURE_MONO_REPO:=https://github.com/rektdeckard/departure-mono}"
: "${DEPARTURE_MONO_COMMIT:=75152a3f1e6dacdd248a6c397c97dbf27e33eea0}" # tag v1.500

# Hyprland + hyprbars come from the Ubuntu archive (hyprland 0.53.3+ds-4, hyprland-plugin-hyprbars 0.53.0-1,
# ABI-matched through the virtual package hyprland-abi-6d24081). They are NOT built here; see image/README.md.
# llama.cpp (8681+dfsg-1) and libggml0-backend-vulkan are in the archive too and are installed by modules.
