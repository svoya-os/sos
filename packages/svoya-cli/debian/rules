#!/usr/bin/make -f
# SPDX-License-Identifier: Apache-2.0
PKG := debian/svoya-cli

%:
	dh $@ --with python3

override_dh_auto_install:
	mkdir -p $(PKG)
	cp -a files/. $(PKG)/

# The `sos new` project templates (svoya_cli/data/new/**.py) contain {{ placeholders }} and are not
# valid Python: exclude them, or py3compile in the generated postinst exits 1 on the first
# SyntaxError and the package fails to configure.
override_dh_python3:
	dh_python3 /usr/lib/svoya -X '.*/svoya_cli/data/'

override_dh_installsystemduser:
	dh_installsystemduser --no-enable

override_dh_fixperms:
	dh_fixperms
	chmod 0755 $(PKG)/usr/bin/sos
	find $(PKG)/usr/share/svoya/modules -type f -name '*.sh' -exec chmod 0755 {} +
