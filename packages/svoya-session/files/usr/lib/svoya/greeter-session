#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# SOS login screen, started by greetd as the "svoya-greeter" user:
# a minimal Hyprland whose only client is the Quickshell greeter (/usr/share/svoya/shell/greeter).
# After a successful login the greeter asks greetd to start /usr/bin/svoya-session and exits;
# Hyprland then exits too and greetd starts the user session.
set -uo pipefail

export XDG_SESSION_TYPE=wayland
export XDG_CURRENT_DESKTOP=sos-greeter
export QT_QPA_PLATFORM=wayland
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
# VirtualBox, VMware, «safe graphics» (nomodeset): draw on the CPU, or Hyprland does not start.
# shellcheck source=packages/svoya-session/files/usr/lib/svoya/gpu-env
[ -r /usr/lib/svoya/gpu-env ] && . /usr/lib/svoya/gpu-env

greeter_dir=/usr/share/svoya/shell/greeter
run="${XDG_RUNTIME_DIR:-/tmp}/svoya-greeter"
mkdir -p "$run"

# Without the Quickshell greeter (broken install) fall back to greetd's text greeter,
# so the machine stays usable.
if ! command -v quickshell >/dev/null || [ ! -f "$greeter_dir/shell.qml" ]; then
    exec /usr/sbin/agreety --cmd /usr/bin/svoya-session
fi

/usr/lib/svoya/session-keyboard >"$run/input.conf" 2>/dev/null || : >"$run/input.conf"
# Hyprland's own log, as in svoya-session (kernel parameter sos.debug); greeter.conf sources it.
if grep -qwE 'sos\.debug|sos\.vmtest=1' /proc/cmdline 2>/dev/null; then
    printf 'debug {\n    disable_logs = false\n    enable_stdout_logs = true\n}\n' >"$run/debug.conf"
else
    : >"$run/debug.conf"
fi
# Its output goes to a file, not onto the login screen's console (a crash used to leave its log
# there); the previous one is kept for the next boot's diagnosis.
glog="${XDG_STATE_HOME:-${HOME:-/var/lib/svoya-greeter}/.local/state}/svoya/greeter.log"
if mkdir -p "${glog%/*}" 2>/dev/null && { [ ! -f "$glog" ] || mv -f "$glog" "$glog.old"; } && : >"$glog" 2>/dev/null; then
    exec >>"$glog" 2>&1
fi

conf=/usr/share/svoya/hypr/greeter.conf
if [ ! -f "$conf" ]; then
    conf="$run/hyprland.conf"
    cat >"$conf" <<EOF
# Generated by /usr/lib/svoya/greeter-session (shell/hypr/greeter.conf not provided).
source = $run/input.conf
misc {
    disable_hyprland_logo = true
    disable_splash_rendering = true
    force_default_wallpaper = 0
}
animations {
    enabled = false
}
cursor {
    no_hardware_cursors = true
}
exec-once = quickshell -p $greeter_dir; hyprctl dispatch exit
EOF
fi

exec Hyprland --config "$conf"
