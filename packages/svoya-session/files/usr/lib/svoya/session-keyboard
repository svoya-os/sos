#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# Print a Hyprland "input" snippet for the keyboard layout chosen at install time
# (/etc/default/keyboard, written by the installer / keyboard-configuration).
# Default for SOS: us,ru switched with Alt+Shift.
set -euo pipefail

XKBMODEL=pc105
XKBLAYOUT=us,ru
XKBVARIANT=,
XKBOPTIONS=grp:alt_shift_toggle
if [ -r /etc/default/keyboard ]; then
    # shellcheck disable=SC1091
    . /etc/default/keyboard
fi

clean() { printf '%s' "$1" | tr -cd 'A-Za-z0-9_,:+().-'; }

cat <<EOF
# Generated by /usr/lib/svoya/session-keyboard from /etc/default/keyboard at login. Do not edit;
# put your own settings into ~/.config/hypr/user.conf instead.
input {
    kb_model = $(clean "${XKBMODEL:-pc105}")
    kb_layout = $(clean "${XKBLAYOUT:-us}")
    kb_variant = $(clean "${XKBVARIANT:-}")
    kb_options = $(clean "${XKBOPTIONS:-}")
}
EOF
