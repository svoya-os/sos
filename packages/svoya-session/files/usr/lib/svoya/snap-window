#!/usr/bin/env python3
# SPDX-License-Identifier: Apache-2.0
"""Super+arrows, the way Windows does them: a floating window snaps to the left or right half of
its screen, Up maximizes it (the bar and gaps stay), Down gives it back its size in the middle;
among tiled windows the arrows move the focus, as before.

    snap-window left|right|up|down

Hyprland 0.53: `hyprctl -j activewindow` / `monitors` for the geometry (logical pixels; `reserved`
is the room the bar takes), then one `hyprctl --batch`. The title bar (hyprbars, 36 px, part of
the window) is drawn above the window's own area, so the window starts that much lower; windows
that draw their own (the browser, Steam: the `hyprbars:no_bar` rule of hyprland.conf) do not.
"""

import json
import os
import re
import subprocess
import sys
from pathlib import Path

GAP = 12            # general:gaps_out
BAR = 36            # plugin:hyprbars:bar_height
FOCUS = {"left": "l", "right": "r", "up": "u", "down": "d"}
NO_BAR = re.compile(r"\s*windowrule\s*=\s*hyprbars:no_bar\s+on\s*,\s*match:class\s+(\S+)\s*$")


def has_bar(window_class: str) -> bool:
    conf = Path(os.environ.get("SVOYA_HYPR_DIR") or "/usr/share/svoya/hypr") / "hyprland.conf"
    try:
        lines = conf.read_text(encoding="utf-8").splitlines()
    except OSError:
        return True
    for line in lines:
        m = NO_BAR.match(line)
        if m:
            try:
                if re.search(m.group(1), window_class or ""):
                    return False
            except re.error:
                continue
    return True


def hyprctl(*args: str) -> str:
    return subprocess.run(["hyprctl", *args], capture_output=True, text=True, timeout=5).stdout


def main(argv: list[str]) -> int:
    where = argv[1] if len(argv) > 1 else ""
    if where not in FOCUS:
        print("usage: snap-window left|right|up|down", file=sys.stderr)
        return 2
    try:
        win = json.loads(hyprctl("-j", "activewindow") or "{}")
    except json.JSONDecodeError:
        win = {}
    if not win or not win.get("floating"):
        hyprctl("dispatch", "movefocus", FOCUS[where])
        return 0
    address = win["address"]
    if where == "up":
        hyprctl("dispatch", "fullscreen", "1")          # maximize: again restores
        return 0
    if win.get("fullscreen"):
        hyprctl("dispatch", "fullscreenstate", "0 0")   # out of maximized first
    try:
        monitors = json.loads(hyprctl("-j", "monitors") or "[]")
    except json.JSONDecodeError:
        return 1
    mon = next((m for m in monitors if m.get("id") == win.get("monitor")), None) or \
        next((m for m in monitors if m.get("focused")), None)
    if mon is None:
        return 1
    scale = float(mon.get("scale") or 1.0)
    left, top, right, bottom = (list(mon.get("reserved") or [0, 0, 0, 0]) + [0, 0, 0, 0])[:4]
    x0 = mon["x"] + left + GAP
    y0 = mon["y"] + top + GAP
    width = mon["width"] / scale - left - right - 2 * GAP
    height = mon["height"] / scale - top - bottom - 2 * GAP
    bar = BAR if has_bar(win.get("class", "")) else 0
    if where in ("left", "right"):
        w = (width - GAP) / 2
        x = x0 if where == "left" else x0 + w + GAP
        box = (x, y0 + bar, w, height - bar)
    else:                                               # down: back to a comfortable size, centered
        w, h = width * 0.62, height * 0.7
        box = (x0 + (width - w) / 2, y0 + bar + (height - h) / 2, w, h - bar)
    x, y, w, h = (int(round(v)) for v in box)
    hyprctl("--batch", f"dispatch resizewindowpixel exact {w} {h},address:{address} ; "
                       f"dispatch movewindowpixel exact {x} {y},address:{address}")
    return 0


if __name__ == "__main__":
    sys.exit(main(sys.argv))
