#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# SOS user session: sets the environment and starts Hyprland with the SOS configuration.
# Started by greetd (the SOS greeter, or the live session's autologin).
# Hyprland then runs `sos session-start` (exec-once in /usr/share/svoya/hypr/hyprland.conf).
set -uo pipefail

export XDG_SESSION_TYPE=wayland
export XDG_SESSION_DESKTOP=sos
export XDG_CURRENT_DESKTOP=sos:Hyprland
export DESKTOP_SESSION=sos
export QT_QPA_PLATFORM="wayland;xcb"
export QT_WAYLAND_DISABLE_WINDOWDECORATION=1
export GDK_BACKEND="wayland,x11"
export MOZ_ENABLE_WAYLAND=1
export ELECTRON_OZONE_PLATFORM_HINT=auto
export _JAVA_AWT_WM_NONREPARENTING=1
export HF_HOME=/srv/ai
export QT_QPA_PLATFORMTHEME=qt6ct

# NVIDIA's proprietary driver is loaded: hints recommended by the Hyprland wiki.
if [ -e /proc/driver/nvidia/version ]; then
    export LIBVA_DRIVER_NAME=nvidia
    export __GLX_VENDOR_LIBRARY_NAME=nvidia
    export NVD_BACKEND=direct
fi

state="${XDG_STATE_HOME:-$HOME/.local/state}/svoya/hypr"
mkdir -p "$state" "$HOME/.config/hypr"
/usr/lib/svoya/session-keyboard >"$state/input.conf.tmp" 2>/dev/null &&
    mv -f "$state/input.conf.tmp" "$state/input.conf"
# hyprland.conf sources these files; each must exist or Hyprland shows a config error banner.
# svoya-colors.conf comes from the theme engine (first login: render it now, before Hyprland starts).
if [ ! -e "$HOME/.config/hypr/svoya-colors.conf" ] && command -v sos >/dev/null; then
    sos theme apply auto --quiet >/dev/null 2>&1 || true
fi
for f in svoya-colors.conf svoya-shell.conf; do
    [ -e "$HOME/.config/hypr/$f" ] || printf '# Generated by SOS; safe to delete.\n' >"$HOME/.config/hypr/$f"
done
if [ ! -e "$HOME/.config/hypr/user.conf" ]; then
    printf '# Your Hyprland settings. They override the SOS defaults (/usr/share/svoya/hypr).\n' \
        >"$HOME/.config/hypr/user.conf"
fi

# Tell systemd --user and D-Bus about the session (portals, Jackson); WAYLAND_DISPLAY is added by
# `sos session-start` once the compositor runs.
if command -v dbus-update-activation-environment >/dev/null; then
    dbus-update-activation-environment --systemd XDG_SESSION_TYPE XDG_SESSION_DESKTOP \
        XDG_CURRENT_DESKTOP DESKTOP_SESSION QT_QPA_PLATFORM QT_QPA_PLATFORMTHEME HF_HOME >/dev/null 2>&1 || true
fi

conf=/usr/share/svoya/hypr/hyprland.conf
if [ ! -f "$conf" ]; then
    # The SOS Hyprland configuration is missing (broken or partial install): start a minimal
    # session that still runs the SOS Shell, so the machine stays usable.
    conf="$state/fallback.conf"
    cat >"$conf" <<EOF
# Generated by /usr/bin/svoya-session: /usr/share/svoya/hypr/hyprland.conf was not found.
source = $state/input.conf
misc {
    disable_hyprland_logo = true
    force_default_wallpaper = 0
}
bind = SUPER, RETURN, exec, kitty
bind = SUPER, Q, killactive
exec-once = sh -c 'sos session-start || exec quickshell -p /usr/share/svoya/shell'
source = $HOME/.config/hypr/user.conf
EOF
fi

# Keep this boot's session output (Hyprland, and everything it starts) for `sos doctor` and bug reports.
log="${XDG_RUNTIME_DIR:-/tmp}/sos-session.log"
{ printf '== SOS session %s (config %s)\n' "$(date -Is 2>/dev/null)" "$conf"; } >>"$log" 2>/dev/null || log=/dev/null

if command -v start-hyprland >/dev/null; then
    # Watchdog shipped with Hyprland 0.53: restarts the compositor in safe mode after a crash.
    exec start-hyprland -- --config "$conf" >>"$log" 2>&1
fi
exec Hyprland --config "$conf" >>"$log" 2>&1
