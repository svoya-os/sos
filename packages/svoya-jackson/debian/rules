#!/usr/bin/make -f
# SPDX-License-Identifier: Apache-2.0
PKG := debian/svoya-jackson

%:
	dh $@ --with python3

override_dh_auto_install:
	mkdir -p $(PKG)
	cp -a files/. $(PKG)/

override_dh_python3:
	dh_python3 /usr/lib/svoya

# jacksond.service is a user unit that `sos session-start` starts on demand; never enable it globally.
override_dh_installsystemduser:
	dh_installsystemduser --no-enable

# jacksond.service links file:///usr/share/doc/svoya-jackson/README.md: keep it uncompressed.
override_dh_compress:
	dh_compress -X README.md

override_dh_fixperms:
	dh_fixperms
	chmod 0755 $(PKG)/usr/bin/jackson $(PKG)/usr/lib/svoya/jacksond
