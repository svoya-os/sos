#!/bin/sh
# SPDX-License-Identifier: Apache-2.0
set -e
THEME=/usr/share/plymouth/themes/svoya-signal/svoya-signal.plymouth
GRUB_THEME_SRC=/usr/share/grub/themes/svoya
case "$1" in
    configure)
        if [ -f "$THEME" ]; then
            update-alternatives --install /usr/share/plymouth/themes/default.plymouth \
                default.plymouth "$THEME" 150
            update-alternatives --set default.plymouth "$THEME" || true
            # plymouthd.conf wins over the alternative on some plymouth builds
            mkdir -p /etc/plymouth
            if [ ! -f /etc/plymouth/plymouthd.conf ] || ! grep -q '^Theme=' /etc/plymouth/plymouthd.conf; then
                printf '[Daemon]\nTheme=svoya-signal\nShowDelay=0\n' >/etc/plymouth/plymouthd.conf
            else
                sed -i 's/^Theme=.*/Theme=svoya-signal/' /etc/plymouth/plymouthd.conf
            fi
        fi
        # GRUB reads its theme from /boot, which stays readable when the root filesystem is
        # encrypted (branding/README.md, /etc/default/grub.d/90-sos-theme.cfg).
        if [ -f "$GRUB_THEME_SRC/theme.txt" ]; then
            rm -rf /boot/grub/themes/svoya
            mkdir -p /boot/grub/themes
            cp -a "$GRUB_THEME_SRC" /boot/grub/themes/svoya
        fi
        ;;
esac
#DEBHELPER#
exit 0
