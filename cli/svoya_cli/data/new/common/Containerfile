# {{ project.name }} — reproducible image. GPU at run time: podman run --device nvidia.com/gpu=all …
FROM docker.io/library/python:3.12-slim
COPY --from=ghcr.io/astral-sh/uv:latest /uv /usr/local/bin/uv
ENV UV_TORCH_BACKEND={{ gpu.backend }} HF_HOME=/srv/ai UV_LINK_MODE=copy
WORKDIR /app
COPY pyproject.toml uv.lock* ./
RUN uv sync --no-install-project
COPY . .
RUN uv sync
CMD ["uv", "run", "python", "{{ run.entry }}"]
