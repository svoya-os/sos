# svoya:generated — theme «{{ name.ru }}» / {{ name.en }} ({{ id }}). Written by `sos theme apply`; edits are overwritten.
# Selected in btop.conf as color_theme = "svoya".

theme[main_bg]="{{ color.surface | hex }}"
theme[main_fg]="{{ color.text | hex }}"
theme[title]="{{ color.text | hex }}"
theme[hi_fg]="{{ color.accent | hex }}"
theme[selected_bg]="{{ color.surface3 | hex }}"
theme[selected_fg]="{{ color.accent | hex }}"
theme[inactive_fg]="{{ color.textFaint | hex }}"
theme[graph_text]="{{ color.textDim | hex }}"
theme[meter_bg]="{{ color.line | hex }}"
theme[proc_misc]="{{ color.cloud | hex }}"
theme[cpu_box]="{{ color.lineStrong | hex }}"
theme[mem_box]="{{ color.lineStrong | hex }}"
theme[net_box]="{{ color.lineStrong | hex }}"
theme[proc_box]="{{ color.lineStrong | hex }}"
theme[div_line]="{{ color.line | hex }}"
theme[temp_start]="{{ color.ok | hex }}"
theme[temp_mid]="{{ color.warn | hex }}"
theme[temp_end]="{{ color.bad | hex }}"
theme[cpu_start]="{{ color.textDim | hex }}"
theme[cpu_mid]="{{ color.accent | mix(color.textDim, 0.5) | hex }}"
theme[cpu_end]="{{ color.accent | hex }}"
theme[free_start]="{{ color.ok | mix(color.surface, 0.5) | hex }}"
theme[free_mid]="{{ color.ok | mix(color.surface, 0.25) | hex }}"
theme[free_end]="{{ color.ok | hex }}"
theme[cached_start]="{{ color.cloud | mix(color.surface, 0.5) | hex }}"
theme[cached_mid]="{{ color.cloud | mix(color.surface, 0.25) | hex }}"
theme[cached_end]="{{ color.cloud | hex }}"
theme[available_start]="{{ color.textFaint | hex }}"
theme[available_mid]="{{ color.textDim | hex }}"
theme[available_end]="{{ color.text | hex }}"
theme[used_start]="{{ color.accent | mix(color.surface, 0.5) | hex }}"
theme[used_mid]="{{ color.accent | mix(color.surface, 0.25) | hex }}"
theme[used_end]="{{ color.accent | hex }}"
theme[download_start]="{{ color.cloud | mix(color.surface, 0.5) | hex }}"
theme[download_mid]="{{ color.cloud | mix(color.surface, 0.25) | hex }}"
theme[download_end]="{{ color.cloud | hex }}"
theme[upload_start]="{{ color.accent | mix(color.surface, 0.5) | hex }}"
theme[upload_mid]="{{ color.accent | mix(color.surface, 0.25) | hex }}"
theme[upload_end]="{{ color.accent | hex }}"
theme[process_start]="{{ color.textDim | hex }}"
theme[process_mid]="{{ color.accent | mix(color.textDim, 0.5) | hex }}"
theme[process_end]="{{ color.accent | hex }}"
