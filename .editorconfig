# EditorConfig for SOS: https://editorconfig.org
root = true

[*]
charset = utf-8
end_of_line = lf
insert_final_newline = true
trim_trailing_whitespace = true
indent_style = space
indent_size = 4

# Python (PEP 8), QML (Qt conventions) and shell scripts use 4 spaces: the default above.

[*.{yml,yaml,json,toml}]
indent_size = 2

# HTML/CSS/JS mockups
[design/**.{html,css,js}]
indent_size = 2

[*.md]
# Two trailing spaces are a hard line break in Markdown.
trim_trailing_whitespace = false

[{Makefile,*.mk}]
indent_style = tab

# License texts are kept exactly as published.
[{LICENSE,LICENSES/*}]
trim_trailing_whitespace = false
insert_final_newline = unset
