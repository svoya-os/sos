# shellcheck shell=bash
# SPDX-License-Identifier: Apache-2.0
# Defaults for the SOS image build. Every value can be overridden from the environment.
# Sourced by image/build-iso.sh and packages/build-all.sh (for SUITE/SNAPSHOT, so .debs and the ISO
# are built against the same frozen archive).

# --- product ------------------------------------------------------------------------------------
: "${SOS_NAME:=SOS}"                          # user-facing product name (Russian: СОС)
: "${SOS_VERSION:=26.10}"
: "${SOS_CODENAME_RU:=Первый сигнал}"
: "${SOS_CODENAME_EN:=First Signal}"
: "${ISO_LABEL:=SOS_2610}"                    # ISO9660 volume id: <= 32 chars, A-Z 0-9 _
: "${ISO_NAME:=sos-${SOS_VERSION}-amd64.iso}"

# --- engine (Ubuntu 26.04 LTS) ------------------------------------------------------------------
: "${SUITE:=resolute}"
: "${ARCH:=amd64}"
: "${COMPONENTS:=main restricted universe multiverse}"
# snapshot.ubuntu.com timestamp the whole build is frozen to; "none" uses the live archive.
: "${SNAPSHOT:=20260920T000000Z}"
: "${SNAPSHOT_MIRROR:=https://snapshot.ubuntu.com/ubuntu}"
# Sources written into the installed system (it must receive updates, so no snapshot there).
: "${TARGET_MIRROR:=http://archive.ubuntu.com/ubuntu/}"
: "${TARGET_SECURITY_MIRROR:=http://security.ubuntu.com/ubuntu/}"

# --- live session -------------------------------------------------------------------------------
: "${LIVE_USER:=svoya}"
: "${LIVE_HOSTNAME:=sos}"
: "${LIVE_LOCALE:=en_US.UTF-8}"
: "${LIVE_TIMEZONE:=Etc/UTC}"

# --- offline driver pool on the ISO (/pool + /dists) --------------------------------------------
# Order = preference. 595-open: Turing (RTX 20) and newer incl. Blackwell. 580: legacy closed modules
# for Maxwell/Pascal/Volta. Both use Canonical-signed prebuilt modules (no DKMS, no MOK enrollment).
: "${NVIDIA_BRANCHES:=595-open 580}"
: "${POOL_STRICT:=1}"                         # 1 = a pool that fails its offline self-test fails the build

# --- compression --------------------------------------------------------------------------------
: "${SQUASHFS_COMP:=zstd}"
: "${SQUASHFS_LEVEL:=19}"                      # 19: ~8 % smaller than 15, slower to build, same boot speed
: "${SQUASHFS_BLOCK:=1M}"

# --- third-party sources used at build time -----------------------------------------------------
: "${MOZILLA_APT_URL:=https://packages.mozilla.org/apt}"
: "${MOZILLA_KEY_URL:=https://packages.mozilla.org/apt/repo-signing-key.gpg}"
: "${MOZILLA_KEY_FPR:=35BAA0B33E9EB396F59CA838C0BA5CE6DC6315A3}"
: "${FLATHUB_REPO_URL:=https://dl.flathub.org/repo/flathub.flatpakrepo}"
