#!/bin/bash
# SPDX-License-Identifier: Apache-2.0
# SOS VM test agent (live image only). Writes "SOS-MARK <uptime> <event>" lines to the first serial
# port and mirrors the journal there, so tests/vm can wait for milestones and keep a boot log.
# When the desktop is late it also dumps "SOS-DIAG" blocks (processes, sessions, failed units, DRM,
# greetd, the user's warnings, Hyprland and session logs) that CI prints into the job log.
set -uo pipefail
tty=/dev/ttyS0
[ -w "$tty" ] || exit 0
stty -F "$tty" 115200 2>/dev/null || true

# The serial port belongs to this agent: a getty on ttyS0 hangs up every other writer (vhangup),
# which silently ended the journal mirror in the first CI run.
systemctl stop serial-getty@ttyS0.service 2>/dev/null || true

mark() { printf 'SOS-MARK %s %s\n' "$(cut -d' ' -f1 /proc/uptime)" "$*" >"$tty"; }

mark agent-start
# The network: NetworkManager has a connection (QEMU's user network is a cable) or not within
# 3 minutes. Plans that download something wait for it (tests/vm/plan.json, model.json, games.json).
( if command -v nm-online >/dev/null && nm-online -q -t 180; then mark network-online; else mark network-offline; fi ) &
cursor=/run/sos-vm-test.journal-cursor
( while :; do
      journalctl -b -f -o short-monotonic --no-hostname --cursor-file="$cursor" >"$tty" 2>&1
      sleep 1
  done ) &

user=${1:-svoya}
uid=$(id -u "$user" 2>/dev/null || echo 1000)

declare -A shown=()          # crash reports already printed (diag runs several times)
diag() {
    {
        echo "SOS-DIAG begin $1"
        echo "## processes"
        ps -eo pid,user,etimes,args --sort=start_time 2>&1 | grep -Ev '\]$|ps -eo' | tail -n 70
        echo "## sessions"
        loginctl list-sessions --no-legend 2>&1
        echo "## failed system units"
        systemctl --failed --no-legend --plain 2>&1
        echo "## drm"
        cat /proc/cmdline
        ls -la /dev/dri 2>&1
        for d in /sys/class/drm/card*; do [ -e "$d/status" ] && echo "$d: $(cat "$d/status")"; done
        for d in /sys/class/drm/card[0-9]*/device/driver; do [ -e "$d" ] && echo "${d%/device/driver}: $(basename "$(readlink -f "$d")")"; done
        # software rendering chosen by /usr/lib/svoya/gpu-env (VirtualBox, VMware, nomodeset), or the GPU
        pid=$(pgrep -u "$user" -x Hyprland | head -n 1)
        if [ -n "$pid" ]; then
            echo "## Hyprland rendering: $(tr '\0' '\n' <"/proc/$pid/environ" | grep -E '^(MESA_LOADER_DRIVER_OVERRIDE|LIBGL_ALWAYS_SOFTWARE|GBM_ALWAYS_SOFTWARE|SVOYA_RENDERER)=' | tr '\n' ' ')"
        fi
        echo "## network (NetworkManager devices, addresses, DNS, netplan)"
        nmcli -t -f DEVICE,TYPE,STATE,CONNECTION device 2>&1 | head -n 8
        ip -brief address 2>&1 | head -n 8
        resolvectl dns 2>&1 | head -n 4
        ls -la /etc/netplan /run/NetworkManager/conf.d 2>&1 | head -n 12
        # user namespaces (Steam's runtime, Flatpak's bwrap, rootless Podman): Ubuntu allows them only
        # under an AppArmor profile that says so, and falls back to the unprivileged_userns profile
        echo "## apparmor (user namespaces)"
        echo "apparmor.service: $(systemctl is-active apparmor.service 2>&1); enabled: $(cat /sys/module/apparmor/parameters/enabled 2>&1)"
        sysctl kernel.apparmor_restrict_unprivileged_userns kernel.unprivileged_userns_clone 2>&1
        echo "profiles loaded: $(grep -c . /sys/kernel/security/apparmor/profiles 2>&1)"
        grep -E '^(unprivileged_userns|steam|sos-steam|bwrap|flatpak|podman|crun|runc)\b' \
            /sys/kernel/security/apparmor/profiles 2>&1 | head -n 12
        echo "/etc/apparmor.d: $(find /etc/apparmor.d -maxdepth 1 -type f 2>/dev/null | wc -l) files;" \
             "$(cd /etc/apparmor.d 2>/dev/null && ls -d unprivileged_userns steam bwrap* flatpak podman 2>/dev/null | tr '\n' ' ')"
        journalctl -b -u apparmor.service --no-pager -o cat 2>&1 | tail -n 8
        echo "## identity (console welcome: /etc/update-motd.d/00-header)"
        ls -la /etc/lsb-release /etc/os-release /usr/lib/os-release 2>&1
        grep -H DESCRIPTION /etc/lsb-release 2>&1
        grep -nE 'lsb|os-release|DESCRIPTION|PRETTY|printf' /etc/update-motd.d/00-header 2>&1 | head -n 12
        sh /etc/update-motd.d/00-header 2>&1 | head -n 3
        echo "## greetd"
        journalctl -b -u greetd --no-pager -o short-monotonic 2>&1 | tail -n 30
        echo "## user $user: warnings and errors"
        journalctl -b "_UID=$uid" -p warning --no-pager -o short-monotonic 2>&1 | tail -n 80
        for f in "/home/$user/.local/state/svoya/session.log" "/run/user/$uid/sos-shell.log"; do
            [ -f "$f" ] && { echo "## $f (tail)"; tail -n 120 "$f"; }
        done
        # The compositors' output (svoya-session, greeter-session; Hyprland logs with sos.vmtest=1):
        # the renderer, errors and assertions, and how each run ended.
        for f in /home/"$user"/.local/state/svoya/hyprland.log /home/"$user"/.local/state/svoya/hyprland.log.old \
                 /var/lib/svoya-greeter/.local/state/svoya/greeter.log /var/lib/svoya-greeter/.local/state/svoya/greeter.log.old; do
            [ -f "$f" ] || continue
            echo "## $f ($(wc -l <"$f") lines: renderer, errors, the end)"
            head -n 3 "$f"
            grep -anE 'ASSERTION|CRIT|ERR|EGL|Renderer:|Vendor:|Using:|[Ff]ailed|abort|terminate|what\(\)|drm: ' "$f" | head -n 60
            tail -n 30 "$f"
        done
        # Hyprland's own log: only what matters (the full file is thousands of lines of DRM detail)
        for f in /run/user/"$uid"/hypr/*/hyprland.log; do
            [ -f "$f" ] && { echo "## $f (renderer, errors, config, exec)"; grep -aE 'Renderer: |Vendor: |ERR|CRIT|WARN|[Cc]onfig|[Ee]xec' "$f" | grep -av 'aquamarine' | tail -n 60; }
        done
        # No shell? Run it once in the foreground for 8 s and keep what it says.
        if ! pgrep -u "$user" -x quickshell >/dev/null; then
            wl=$(find "/run/user/$uid" -maxdepth 1 -name 'wayland-[0-9]' -printf '%f\n' 2>/dev/null | head -n 1)
            sig=$(find "/run/user/$uid/hypr" -mindepth 1 -maxdepth 1 -type d -printf '%f\n' 2>/dev/null | head -n 1)
            echo "## probe: quickshell -p /usr/share/svoya/shell (8 s, WAYLAND_DISPLAY=$wl)"
            timeout 8 runuser -u "$user" -- env XDG_RUNTIME_DIR="/run/user/$uid" WAYLAND_DISPLAY="$wl" \
                HYPRLAND_INSTANCE_SIGNATURE="$sig" QT_QPA_PLATFORM=wayland LANG=ru_RU.UTF-8 \
                quickshell -p /usr/share/svoya/shell 2>&1 | tail -n 100
            echo "## probe exit: ${PIPESTATUS[0]}"
        fi
        # Hyprland's crash reports (the session's and the greeter's), once each: the backtrace and the
        # log tail, the lines before the abort that a buffered stdout loses
        for f in /home/"$user"/.cache/hyprland/hyprlandCrashReport*.txt \
                 /home/"$user"/.local/share/hyprland/hyprlandCrashReport*.txt \
                 /var/lib/svoya-greeter/.cache/hyprland/hyprlandCrashReport*.txt; do
            [ -f "$f" ] || continue
            if [ -n "${shown[$f]:-}" ]; then echo "## $f (above)"; continue; fi
            shown[$f]=1
            echo "## $f"
            head -n 8 "$f"
            echo "# backtrace"
            sed -n '/^Backtrace:/,/^Log tail:/p' "$f" | grep -avE '^[[:space:]]*(\?\?:[0-9?]*)?$' | head -n 60
            echo "# log tail"
            sed -n '/^Log tail:/,$p' "$f" | tail -n 70
        done
        echo "SOS-DIAG end $1"
    } >"$tty" 2>&1
}

deadline=$((SECONDS + 900))
greetd_seen=0
next_diag=60
while [ "$SECONDS" -lt "$deadline" ]; do
    if [ "$greetd_seen" = 0 ] && systemctl is-active --quiet greetd.service; then
        mark greetd-active
        greetd_seen=1
    fi
    if pgrep -u "$user" -x Hyprland >/dev/null; then
        [ -n "${hypr_seen:-}" ] || { mark hyprland-running; hypr_seen=1; }
    fi
    # The shell itself (process name, not a command line that merely mentions it) and still alive
    # 5 s later: the first CI run counted the `sh -c '… quickshell …'` wrapper as a running shell.
    if pgrep -u "$user" -x Hyprland >/dev/null && pgrep -u "$user" -x quickshell >/dev/null; then
        sleep 5
        if pgrep -u "$user" -x quickshell >/dev/null; then
            mark desktop-ready
            diag ready
            break
        fi
        mark shell-restarting
    fi
    if [ "$SECONDS" -ge "$next_diag" ]; then
        diag "t+${SECONDS}s"
        next_diag=$((next_diag * 2))
    fi
    sleep 1
done
[ "$SECONDS" -lt "$deadline" ] || { mark desktop-timeout; diag timeout; }
wait
